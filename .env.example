# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Tone server (server/) — see docs/GRAPTION_CONTEXT.md §7 ---
DEPLOY_MODE=local            # local | tunnel | cloud
TONE_BACKEND=audeering       # audeering | custom
TONE_HEAD_PATH=              # path to tone-head-vN.pt (custom backend)
TAG_THRESHOLD=0.6
TONE_FALLBACK_TAG=calm        # demo default when no confident tone; empty sends null
TONE_TOKEN=                  # optional override for the token generated by QR pairing
# GRAPTION_PAIR_URL=         # optional override for the Mac's automatic .local address
LOG_EXPORT_BUCKET=           # cloud only: GCS bucket for SQLite export
# TONE_LOG_DIR=              # optional override; default is repo-root logs/

# --- Optional Mac/cloud transcription (server/ /ws/asr) ---
ASR_BACKEND=mock             # mock | mlx | deepgram (phone falls back to WhisperKit)
DEEPGRAM_API_KEY=            # only for ASR_BACKEND=deepgram; stays on the Mac
DEEPGRAM_MODEL=nova-3

# --- Meeting AI (server/ on the Mac): OpenAI if set, else OpenRouter ---
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=

# --- OpenAI: Mac meeting AI and language/ benchmarks — NEVER the iOS app ---
OPENAI_API_KEY=

# --- ML (ml/) ---
WANDB_API_KEY=
