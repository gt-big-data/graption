# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Tone server (server/) — see docs/GRAPTION_CONTEXT.md §7 ---
DEPLOY_MODE=local            # local | tunnel | cloud
TONE_BACKEND=audeering       # audeering | custom
TONE_HEAD_PATH=              # path to tone-head-vN.pt (custom backend)
TAG_THRESHOLD=0.6
TONE_TOKEN=                  # required when DEPLOY_MODE is tunnel or cloud
LOG_EXPORT_BUCKET=           # cloud only: GCS bucket for SQLite export

# --- Language team (language/) — benchmark scripts only, NEVER the iOS app ---
OPENAI_API_KEY=

# --- ML (ml/) ---
WANDB_API_KEY=
