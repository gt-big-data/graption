Geometry x="60" y="1060" width="160" height="30" as="geometry"/></mxCell><mxCell id="lg1" value="Custom-trained model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="235" y="1060" width="160" height="30" as="geometry"/></mxCell><mxCell id="lg2" value="App / backend code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="1060" width="160" height="30" as="geometry"/></mxCell><mxCell id="lg3" value="Hardware sensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="585" y="1060" width="160" height="30" as="geometry"/></mxCell><mxCell id="lg4" value="Dataset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="1060" width="160" height="30" as="geometry"/></mxCell><mxCell id="lg5" value="What the user sees" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontSize=11;" vertex="1" parent="1"><mxGeometry x="935" y="1060" width="160" height="30" as="geometry"/></mxCell><mxCell id="lgn" value="&lt;font color=&quot;#9673a6&quot;&gt;&lt;b&gt;- - - →&lt;/b&gt;&lt;/font&gt;  network (Wi-Fi WebSocket; all timestamps use the phone&#x27;s clock)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="1060" width="340" height="30" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;If the Mac is unreachable:&lt;/b&gt; captions, speaker highlights and sound alerts still work (all on the phone); only tone tags drop.   &lt;b&gt;Targets:&lt;/b&gt; speaker highlight ~0.3–0.5s · sound alerts ~0.5–1s · captions ~1–2s · tone ~0.5s after sentence ends (never blocks captions)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1100" width="1380" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>